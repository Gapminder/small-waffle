# Server ID in the dataset control list, not the public hostname.
SERVER_ID=your-waffle-server-id
GET_ALLOWED_DATASETS_FROM=supabase_db

# Supabase mode: hostname only; keep both keys server-side.
SUPABASE_ENDPOINT=your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Standalone only: use the same random secret for the API and Git worker.
SIDECAR_SECRET=

# Optional: for public GitHub API lookups.
GITHUB_TOKEN=

# Spreadsheet mode: set GET_ALLOWED_DATASETS_FROM=google_spreadsheet and one ID.
ALLOWED_DATASETS_GOOGLE_SPREADSHEET_ID=
ALLOWED_DATASETS_GOOGLE_SPREADSHEET_PUBLISH_ON_WEB_ID=
